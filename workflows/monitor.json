      "parameters": {
        "sendTo": "CONFIGURE_RECIPIENT_EMAIL",
        "subject": " AI Recruitment Workflow Error",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:650px;margin:auto;background:#f5f7fb;padding:25px;\">\n\n  <div style=\"background:#dc2626;color:white;padding:22px;border-radius:12px 12px 0 0;\">\n    <h2 style=\"margin:0;\">🚨 Workflow Error Alert</h2>\n    <p style=\"margin:8px 0 0;\">An automation workflow requires your attention.</p>\n  </div>\n\n  <div style=\"background:white;padding:25px;border-radius:0 0 12px 12px;\">\n\n    <p><strong>Workflow</strong><br>\n    {{ $json.workflowName }}</p>\n\n    <p><strong>Failed Node</strong><br>\n    {{ $json.nodeName }}</p>\n\n    <p><strong>Error</strong><br>\n    <span style=\"color:#dc2626;\">\n      {{ $json.errorMessage }}\n    </span>\n    </p>\n\n    <p><strong>Time</strong><br>\n    {{ $json.timestamp }}</p>\n\n    <p><strong>Execution ID</strong><br>\n    {{ $json.executionId }}</p>\n\n    <div style=\"background:#fff7ed;padding:15px;border-radius:8px;margin-top:20px;\">\n      ⚠️ Please check the workflow execution.\n    </div>\n\n  </div>\n\n  <p style=\"text-align:center;color:#888;font-size:12px;margin-top:15px;\">\n    AI Automation Monitoring System\n  </p>\n\n</div>",
