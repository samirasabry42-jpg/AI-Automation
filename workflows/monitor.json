        "subject": "📊 Daily Error Digest",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;background:#f5f7fb;padding:30px;\">\n\n  <div style=\"max-width:700px;margin:auto;background:white;border-radius:14px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.08);\">\n\n    <div style=\"background:#1e3a8a;color:white;padding:25px;\">\n      <h1 style=\"margin:0;font-size:24px;\">📊 Daily Error Digest</h1>\n      <p style=\"margin:8px 0 0;font-size:14px;\">\n        Daily automation health report\n      </p>\n    </div>\n\n    <div style=\"padding:25px;\">\n\n      <p style=\"font-size:15px;color:#444;\">\n        Good morning 👋\n      </p>\n\n      <p style=\"font-size:14px;color:#666;\">\n        Here is your daily automation monitoring report.\n      </p>\n\n      <div style=\"background:#eff6ff;border-radius:12px;padding:20px;text-align:center;margin:25px 0;\">\n        <div style=\"font-size:13px;color:#64748b;\">\n          TOTAL ERRORS\n        </div>\n\n        <div style=\"font-size:36px;font-weight:bold;color:#1e3a8a;margin-top:5px;\">\n          {{ $json.errorCount }}\n        </div>\n      </div>\n\n      <div style=\"background:#f8fafc;border-radius:10px;padding:20px;\">\n        <h3 style=\"margin-top:0;color:#1e293b;\">\n          Error Details\n        </h3>\n\n        <div style=\"white-space:pre-line;font-size:14px;color:#475569;line-height:1.7;\">\n          {{ $json.digest }}\n        </div>\n      </div>\n\n      <div style=\"margin-top:25px;padding:15px;background:#fff7ed;border-left:4px solid #f97316;border-radius:6px;\">\n        <strong>⚠️ Recommended Action</strong>\n        <p style=\"margin:6px 0 0;color:#666;\">\n          Review the errors and check the affected workflow executions.\n        </p>\n      </div>\n\n    </div>\n\n    <div style=\"background:#f8fafc;padding:15px;text-align:center;color:#888;font-size:12px;\">\n      AI Automation Monitoring System\n    </div>\n\n  </div>\n\n</div>",
        "options": {}
