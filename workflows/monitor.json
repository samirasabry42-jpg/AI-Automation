    {
      "id": "node-9",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -288
      ],
      "parameters": {
        "jsCode": "const cutoff=Date.now()-24*60*60*1000;const errors=$input.all().map(i=>i.json).filter(e=>e.timestamp&&new Date(e.timestamp).getTime()>=cutoff);\n\nif (errors.length === 0) {\n  return [\n    {\n      json: {\n        hasErrors: false,\n        errorCount: 0,\n        digest: \"No errors were recorded today.\"\n      }\n    }\n  ];\n}\n\nconst errorCount = errors.length;\n\nconst lines = errors.map((error, index) => {\n  return `${index + 1}. Workflow: ${error.workflowName || \"Unknown\"}\n   Node: ${error.nodeName || \"Unknown\"}\n   Error: ${error.errorMessage || \"Unknown error\"}\n   Time: ${error.timestamp || \"Unknown\"}`;\n});\n\nconst digest = `Daily Error Digest\n====================\n\nTotal Errors: ${errorCount}\n\n${lines.join(\"\\n\\n\")}`;\n\nreturn [\n  {\n    json: {\n      hasErrors: true,\n      errorCount,\n      digest\n    }\n  }\n];"
      }
    },
