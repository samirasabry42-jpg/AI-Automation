      "id": "node-2",
      "name": "Code Throttle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        -496
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst current = $('Classify Error').first().json;\n\nconst now = new Date();\nconst throttleMinutes = 15;\n\nconst recentAlert = items.some(item => {\n  const alert = item.json;\n\n  if (!alert.timestamp) return false;\n\n  const alertTime = new Date(alert.timestamp);\n  const diffMinutes = (now - alertTime) / (1000 * 60);\n\n  return (\n    diffMinutes >= 0 &&\n    diffMinutes <= throttleMinutes &&\n    alert.workflowName === current.workflowName\n  );\n});\n\nreturn [\n  {\n    json: {\n      ...current,\n      shouldAlert: !recentAlert,\n      throttled: recentAlert\n    }\n  }\n];"
      }
    },
    {
      "id": "node-3",
      "name": "Classify Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        -512
      ],
      "parameters": {
        "jsCode": "const error = $json;\n\nreturn [\n  {\n    json: {\n      workflowName: error.workflow?.name || 'Unknown',\n      executionId: error.execution?.id || 'Unknown',\n      errorMessage: error.execution?.error?.message || 'Unknown error',\n      errorTime: new Date().toISOString(),\n      nodeName: error.execution?.lastNodeExecuted || 'Unknown'\n    }\n  }\n];"
      }
    },
