    {
      "id": "node-14",
      "name": "Find Stuck Applications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -96
      ],
      "parameters": {
        "jsCode": " const applications = $input.all();\n\nconst STUCK_HOURS = 24;\nconst now = new Date();\n\nconst stuckApplications = applications.filter(item => {\n  const app = item.json;\n\n  const appliedAt = app[\"Applied At\"] || app.appliedAt;\n\n  if (!appliedAt) return false;\n\n  const appliedTime = new Date(appliedAt);\n\n  if (isNaN(appliedTime.getTime())) return false;\n\n  const hoursWaiting =\n    (now - appliedTime) / (1000 * 60 * 60);\n\n  return hoursWaiting >= STUCK_HOURS;\n});\n\nreturn [\n  {\n    json: {\n      hasStuckApplications: stuckApplications.length > 0,\n      stuckCount: stuckApplications.length,\n      applications: stuckApplications.map(item => ({\n        name: item.json.Name || item.json.name,\n        email: item.json.Email || item.json.email,\n        status: item.json.Status || item.json.status,\n        appliedAt: item.json[\"Applied At\"] || item.json.appliedAt\n      }))\n    }\n  }\n];"
      }
    },
