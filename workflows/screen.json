      "parameters": {
        "promptType": "define",
        "text": "={You are an experienced recruiter. Evaluate this candidate for the position below.\n\nPOSITION: {{ $('Prepare Application').first().json.position }}\n\nREQUIREMENTS: {{ $('Prepare Application').first().json.jobRequirements }}\n\nCANDIDATE CV:\n{{ $('Prepare Application').first().json.cvText }}\n\nEvaluate the candidate based on their CV, the position, and the job requirements.}",
        "hasOutputParser": true,
        "batching": {}
      }
    },
    {
      "id": "node-14",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2832,
        -64
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 100\n    },\n    \"recommendation\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"interview\",\n        \"maybe\",\n        \"reject\"\n      ]\n    },\n    \"matched_requirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Requirements from the job description that the candidate meets\"\n    },\n    \"missing_requirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Requirements from the job description that the candidate does not meet\"\n    },\n    \"strengths\": {\n      \"type\": \"string\",\n      \"description\": \"Two sentences on the candidate's strongest points for this job\"\n    },\n    \"concerns\": {\n      \"type\": \"string\",\n      \"description\": \"One or two sentences on the main risks or gaps\"\n    },\n    \"interview_questions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"3 targeted interview questions\"\n    }\n  },\n  \"required\": [\n    \"score\",\n    \"recommendation\",\n    \"matched_requirements\",\n    \"missing_requirements\",\n    \"strengths\",\n    \"concerns\",\n    \"interview_questions\"\n  ]\n}"
      }
    },
    {
      "id": "node-15",
      "name": "Validate Evaluation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3232,
        -272
      ],
      "parameters": {
        "jsCode": " const ev = $input.first().json.output ?? $input.first().json;\nconst app = $('Prepare Application').first().json;\nconst profile = $('Extract Candidate Profile').first().json.output || {};\nconst cv = (app.cvText || '').toLowerCase();\nconst problems = [];\n\nif (!Number.isInteger(ev.score) || ev.score < 0 || ev.score > 100)\n  problems.push('score must be a whole number from 0 to 100');\n\nif (!['interview', 'maybe', 'reject'].includes(ev.recommendation))\n  problems.push('recommendation must be interview, maybe or reject');\n\nif (ev.recommendation === 'interview' && ev.score < 70)\n  problems.push('interview needs a score of 70 or more');\n\nif (ev.recommendation === 'reject' && ev.score >= 40)\n  problems.push('reject needs a score below 40');\n\nif (!(ev.matched_requirements || []).length &&\n    !(ev.missing_requirements || []).length)\n  problems.push('the evaluation lists no requirements');\n\nconst unverified = (profile.skills || []).filter(s =>\n  !cv.includes(String(s).toLowerCase().split(' ')[0])\n);\n\nif (unverified.length > 2)\n  problems.push('skills not found in the CV: ' + unverified.join(', '));\n\nconst { cvText, jobRequirements, ...applicant } = app;\n\nreturn [{\n  json: {\n    ...applicant,\n    ...ev,\n    yearsExperience: profile.years_experience ?? '',\n    topSkills: (profile.skills || []).slice(0, 6).join(', '),\n    valid: problems.length === 0,\n    problems: problems.join('; ')\n  }\n}];"
      }
    },
